# ──────────────────────────────────────────────
# Orami's Kitty Config
# Archivo: ~/.config/kitty/kitty.conf
# Tema: Cyberpunk Sakura
# ──────────────────────────────────────────────

# ─[FUENTE]────────────────────────────────────
# JetBrainsMono Nerd Font incluye iconos para eza, powerline, etc.
# La variante Mono evita que los iconos se superpongan con el texto.
font_family      JetBrainsMono Nerd Font Mono
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size        12.0

# Ajuste fino de renderizado de texto. 0.0 = sin ajuste.
adjust_line_height  0
adjust_column_width 0

# ─[CURSOR]────────────────────────────────────
# Forma del cursor: block, beam, underline.
cursor_shape block

# 0 desactiva el parpadeo completamente.
cursor_blink_interval 0

# No retoma parpadeo tras inactividad.
cursor_stop_blinking_after 0

# ─[VENTANA]───────────────────────────────────
# Espacio interno entre el texto y el borde de la ventana.
window_padding_width 10

# Margen externo entre ventanas en splits. 0 evita franjas visibles.
window_margin_width 3

# Permite cambiar la opacidad en caliente con atajos de teclado.
dynamic_background_opacity yes

# ─[APARIENCIA]────────────────────────────────
# 0.0 = transparente total, 1.0 = solido.
background_opacity 0.85

# Opacidad de ventanas inactivas en splits.
dim_opacity 0.75

# ─[AUDIO]─────────────────────────────────────
# Desactiva el beep del sistema.
enable_audio_bell no

# Desactiva el flash visual como reemplazo del beep.
visual_bell_duration 0

# ─[COLORES PRINCIPALES]───────────────────────
# Color del texto normal.
foreground #a9b1d6

# Color de fondo principal.
background #1a1b26

# Texto y fondo al seleccionar con el mouse.
selection_foreground #000000
selection_background #bb9af7

# Color de las URLs detectadas automaticamente.
url_color #73daca

# Subrayado ondulado bajo URLs. Opciones: none, single, curly.
url_style curly

# ─[COLORES ANSI - NORMALES]───────────────────
# Negro: fondo oscuro para contraste.
color0  #1a1b26

# Rojo sakura: errores, alertas.
color1  #f7768e

# Verde: confirmaciones, exito.
color2  #9ece6a

# Amarillo: advertencias.
color3  #e0af68

# Azul: informacion, directorios.
color4  #7aa2f7

# Violeta: tipos especiales.
color5  #bb9af7

# Cyan: enlaces, strings.
color6  #7dcfff

# Gris claro: texto secundario.
color7  #a9b1d6

# ─[COLORES ANSI - BRILLANTES]─────────────────
# Gris oscuro: comentarios, texto inactivo.
color8  #414868

# Rojo neon: errores criticos.
color9  #ff007c

# Verde fosforescente: exito brillante.
color10 #00ff87

# Amarillo laser: resaltado fuerte.
color11 #f5f500

# Cyan brillante: info destacada.
color12 #00cfff

# Magenta neon: elementos especiales.
color13 #ff00ff

# Aqua cyber: resaltado de sintaxis.
color14 #5fffff

# Blanco puro: texto de maximo contraste.
color15 #ffffff

# ─[BARRA DE PESTAÑAS]─────────────────────────
# Estilo con separadores tipo powerline.
tab_bar_style powerline

# Posicion de la barra: bottom o top.
tab_bar_edge bottom

# Forma del separador: angled, slanted, round.
tab_powerline_style slanted

# Texto de la pestana activa.
active_tab_foreground #1a1b26

# Fondo de la pestana activa.
active_tab_background #7aa2f7

# Texto de pestanas inactivas.
inactive_tab_foreground #a9b1d6

# Fondo de pestanas inactivas.
inactive_tab_background #24283b

# Pestana activa en negrita, inactivas en peso normal.
active_tab_font_style bold
inactive_tab_font_style normal

# Plantilla del titulo con padding visual.
tab_title_template " {title} "

# ─[SCROLLBACK]────────────────────────────────
# Lineas guardadas en el buffer de scroll.
scrollback_lines 10000

# MB adicionales en disco para historial largo. 0 = desactivado.
scrollback_pager_history_size 0

# Velocidad del scroll con rueda del mouse.
wheel_scroll_multiplier 5.0

# ─[MOUSE]─────────────────────────────────────
# Oculta el cursor del mouse tras 3 segundos de inactividad.
mouse_hide_wait 3.0

# Usa el navegador por defecto del sistema para abrir URLs.
open_url_with default

# No copia automaticamente al seleccionar texto.
copy_on_select no

# ─[RENDIMIENTO]───────────────────────────────
# Milisegundos entre repaints. Menor = mas fluido, mas CPU.
repaint_delay 10

# Latencia de entrada en ms. 3 es el minimo recomendado.
input_delay 3

# Sincroniza el repaint con el refresco del monitor.
sync_to_monitor yes

# ─[KEYBINDINGS]───────────────────────────────
# Copiar y pegar.
map ctrl+shift+c copy_to_clipboard
map ctrl+shift+v paste_from_clipboard

# Control de opacidad en caliente (requiere dynamic_background_opacity yes).
map ctrl+shift+a>m set_background_opacity +0.1
map ctrl+shift+a>l set_background_opacity -0.1
map ctrl+shift+a>1 set_background_opacity 1
map ctrl+shift+a>d set_background_opacity default

# Splits: ventanas internas de kitty.
map ctrl+shift+enter new_window
map ctrl+shift+w     close_window
map ctrl+shift+]     next_window
map ctrl+shift+[     previous_window

# Pestanas.
map ctrl+shift+t     new_tab
map ctrl+shift+q     close_tab
map ctrl+shift+right next_tab
map ctrl+shift+left  previous_tab
